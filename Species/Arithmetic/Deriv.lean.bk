import Species.Basic
import Species.Operations.Deriv
import Species.Operations.Add
import Species.Operations.Mul

namespace Species

variable {U: Type} [Fintype U] {F G: Type → Type}

theorem leibniz_add_eq : Deriv (Add F G) = Add (Deriv F) (Deriv G) := by rfl
def leibniz_add : Deriv (Add F G) U ≃ Add (Deriv F) (Deriv G) U := Equiv.refl _

variable [Species F] [Species G]

def InnerOptionEquiv {U : Type} {d : WithBot U → Bool} {b: Bool} (h : d ⊥ = b)
: { u // d u = !b } ≃ { u : U // d (WithBot.some u) = !b } where
  toFun
    | ⟨⊥, hu⟩   => by rw [h] at hu; simp at *
    | ⟨WithBot.some u, hu⟩ => ⟨u, hu⟩
  invFun x    := ⟨WithBot.some x.1, x.2⟩
  left_inv    := by
    rintro ⟨x, hu⟩
    induction x with
    | bot   => rw [h] at hu; simp at hu
    | coe x => rfl
  right_inv _ := by rfl

def OuterOptionEquiv {U : Type} {d : WithBot U → Bool} {b: Bool} (h : d ⊥ = b)
: { u // d u = b } ≃ WithBot { u : U // d (WithBot.some u) = b } where
  toFun
    | ⟨⊥, _⟩    => ⊥
    | ⟨WithBot.some u, hu⟩ => WithBot.some ⟨u, hu⟩
  invFun
    | ⊥         => ⟨⊥, h⟩
    | WithBot.some ⟨u, hu⟩ => ⟨WithBot.some u, hu⟩
  left_inv  := by rintro ⟨(_ | u), hu⟩ <;> rfl
  right_inv := by rintro (_ | ⟨u, hu⟩) <;> rfl

@[simp] theorem transportEquiv_apply {U V} [Finite U] [Finite V] (σ : U ≃ V) (f : F U) :
  transportEquiv σ f = transport σ f := rfl

theorem transport_heq {F : Type → Type} [Species F] {α β : Type} [Finite α] [Finite β]
  (hαβ : α = β) (σ : α ≃ β) (hσ : ∀ a, HEq (σ a) a) (f : F α)
: HEq (transport σ f) f := by
  subst hαβ
  have : σ = Equiv.refl α := Equiv.ext fun a => eq_of_heq (hσ a)
  rw [this, id_transport]

def leibniz_mul : Deriv (Mul F G) U ≃ Add (Mul (Deriv F) G) (Mul F (Deriv G)) U where
  toFun :=
    fun ⟨d, f, g⟩ =>
      match h : d ⊥ with
      | true  =>
        .inr ⟨
          fun u => d (WithBot.some u),
          transportEquiv (InnerOptionEquiv h) f,
          transportEquiv (OuterOptionEquiv h) g
        ⟩
      | false =>
        .inl ⟨
          fun u => d (WithBot.some u),
          transportEquiv (OuterOptionEquiv h) f,
          transportEquiv (InnerOptionEquiv h) g
        ⟩

  invFun
    | .inl ⟨d, f, g⟩ => ⟨
        fun u =>
          match u with
          | ⊥ => false
          | WithBot.some u => d u,
        transportEquiv (OuterOptionEquiv (b := false) (by rfl)).symm f,
        transportEquiv (InnerOptionEquiv (b := false) (by rfl)).symm g
      ⟩
    | .inr ⟨d, f, g⟩ => ⟨
        fun u =>
          match u with
          | ⊥ => true
          | WithBot.some u => d u,
        transportEquiv (InnerOptionEquiv (b := true) (by rfl)).symm f,
        transportEquiv (OuterOptionEquiv (b := true) (by rfl)).symm g
      ⟩

  -- TODO terribly ugly, much duplication, cleanup
  left_inv := by
    rintro ⟨d, f, g⟩; beta_reduce; split
    . next x d' f' g' heq =>
      beta_reduce; simp at heq; split at heq
      . contradiction
      . injection heq with val_eq
        have h: (fun u => match u with | ⊥ => false | WithBot.some u => d' u) = d := by
          ext ⟨x⟩ <;> simp
          . assumption
          . simp at val_eq; obtain ⟨l, _⟩ := val_eq; simp [← l]; congr
        congr
        . simp [← h]
        . simp [← h]
        . next val =>
          injection val_eq        with hd hfg; subst hd
          injection eq_of_heq hfg with hf hg ; subst hf
          simp [transport_transport]
          refine transport_heq ?_ _ ?_ f
          · exact congrArg (fun e => { u // e u = false }) h.symm
          . rintro ⟨u, hu⟩
            cases u <;> simp [OuterOptionEquiv]
            . congr
              . funext u; simp; rw [← h]
              . exact proof_irrel_heq _ _
            . congr; funext u; simp; rw [← h]
        . next val =>
          injection val_eq        with hd hfg; subst hd
          injection eq_of_heq hfg with hf hg ; subst hg
          simp [transport_transport]
          refine transport_heq ?_ _ ?_ g
          · exact congrArg (fun e => { u // e u = true }) h.symm
          . rintro ⟨u, hu⟩
            induction u with
            | bot => simp [InnerOptionEquiv]
            cases u <;> simp [InnerOptionEquiv]
            . simp [val] at hu
            . congr; simp; funext u; simp
              have x := congrFun h u
              exact x
    . next x d' f' g' heq =>
      simp at heq; split at heq
      . injection heq with val_eq
        have h: (fun u => match u with | ⊥ => true | WithBot.some u => d' u) = d := by
          ext ⟨x⟩ <;> simp
          . assumption
          . obtain ⟨⟩ := val_eq; simp -- somehow this works?
        congr
        . simp [← h]
        . simp [← h]
        . next val =>
          injection val_eq        with hd hfg; subst hd
          injection eq_of_heq hfg with hf hg ; subst hf
          simp [transport_transport]
          refine transport_heq ?_ _ ?_ f
          · exact congrArg (fun e => { u // e u = false }) h.symm
          . rintro ⟨u, hu⟩; cases u <;> simp [InnerOptionEquiv]
            . simp [val] at hu
            . congr; funext u; simp; rw [← h]
        . next val =>
          injection val_eq        with hd hfg; subst hd
          injection eq_of_heq hfg with hf hg ; subst hg
          simp [transport_transport]
          refine transport_heq ?_ _ ?_ g
          · exact congrArg (fun e => { u // e u = true }) h.symm
          . rintro ⟨u, hu⟩
            cases u <;> simp [OuterOptionEquiv]
            . congr
              . funext u; simp; rw [← h]
              . exact proof_irrel_heq _ _
            . congr; funext u; simp; rw [← h]
      . contradiction

  right_inv := by
    set_option pp.proofs true in
    rintro (⟨d, f, g⟩ | ⟨d, f, g⟩)
      <;> simp only [transportEquiv_symm]
      <;> beta_reduce
      <;> simp only [Equiv.apply_symm_apply]
      <;> congr
      <;> simp [transportEquiv]
      <;> simp [OuterOptionEquiv]

    rw [transport_transport]


    rintro (⟨d, f, g⟩ | ⟨d, f, g⟩)
      <;> simp only [transportEquiv_symm, Equiv.apply_symm_apply]
      <;> congr <;> simp [transportEquiv]

    rintro (⟨d, f, g⟩ | ⟨d, f, g⟩)
    · unfold transportEquiv
      simp only [Equiv.coe_fn_mk]
      beta_reduce
      rw [transport_transport, Equiv.symm_trans_self, id_transport]
      congr
      have : Finite (WithBot { u // d ↑u = false }) := inferInstance
    . sorry
    /- rintro (⟨d, f, g⟩ | ⟨d, f, g⟩) <;> beta_reduce -/
    /- . simp [transport_transport]; congr -/
    /- . sorry -/
    /- <;> rw [transportEquiv, transport_transport, id_transport, Equiv.symm_trans_self] -/

end Species
